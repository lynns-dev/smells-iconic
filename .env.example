# QuickBooks Payments — from an Intuit Developer app with Payments enabled
# (developer.intuit.com > your app > Keys & OAuth). QB_CLIENT_ID / QB_CLIENT_SECRET
# are the app's credentials, used to authorize once via /api/qb-auth/connect
# and to silently refresh the access token afterward — see DEPLOYMENT.md.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
# Same value as QB_ENVIRONMENT, exposed to the browser so client-side card
# tokenization (lib/qbPayments.js) hits the matching sandbox/production API.
NEXT_PUBLIC_QB_ENVIRONMENT=sandbox

# KV store (Vercel KV or a standalone Upstash Redis both work — same REST API)
# used to persist the QuickBooks refresh token between requests so checkout
# can renew its own access token automatically, all day, with no manual steps.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Your deployed URL (Vercel sets this; use http://localhost:3000 locally)
NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app

# Powers the "or choose another way to pay" options at checkout (Cash App
# Pay, Klarna, Afterpay, Affirm) — customers never see the word "Stripe",
# only each method's own brand name. From dashboard.stripe.com > Developers
# > API keys (test mode keys while you're testing). See DEPLOYMENT.md for
# the full walkthrough, including enabling each method and the webhook.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you create at dashboard.stripe.com > Developers
# > Webhooks, pointed at https://YOUR_DOMAIN/api/stripe-webhook, subscribed
# to payment_intent.succeeded. Required — orders placed through these
# methods are only recorded once this webhook fires.
STRIPE_WEBHOOK_SECRET=

# Password for /admin (revenue, funnel analytics, live visitors, review
# moderation). Sessions are stored in the same KV store above.
ADMIN_PASSWORD=
